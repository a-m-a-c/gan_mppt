{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "CMake: configure Debug",
      "command": "C:/ST/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
      "args": ["--preset", "Debug"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "process",
      "label": "CMake: build",
      "command": "C:/ST/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
      "args": ["--build", "--preset", "Debug"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "dependsOn": ["CMake: configure Debug"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      // Flashes the already-built Debug ELF via STM32CubeProgrammer CLI and
      // resets the target so it starts running immediately (no debug session).
      "type": "process",
      "label": "Flash (ST-LINK)",
      "command": "C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
      "args": [
        "-c", "port=SWD",
        "-w", "${workspaceFolder}/firmware/build/Debug/gan_mppt_firmware.elf",
        "-v",
        "-rst"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build & Flash Debug",
      "dependsOn": ["CMake: build", "Flash (ST-LINK)"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "process",
      "label": "CMake: configure Release",
      "command": "C:/ST/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
      "args": ["--preset", "Release"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "process",
      "label": "CMake: build Release",
      "command": "C:/ST/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
      "args": ["--build", "--preset", "Release"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "dependsOn": ["CMake: configure Release"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "process",
      "label": "Flash Release (ST-LINK)",
      "command": "C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
      "args": [
        "-c", "port=SWD",
        "-w", "${workspaceFolder}/firmware/build/Release/gan_mppt_firmware.elf",
        "-v",
        "-rst"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build & Flash Release",
      "dependsOn": ["CMake: build Release", "Flash Release (ST-LINK)"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
